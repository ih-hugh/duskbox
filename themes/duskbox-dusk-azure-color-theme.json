    },
    "property": {
      "foreground": "#44d0c1"
    },
    "string": {
      "foreground": "#85cc87"
    },
    "number": {
      "foreground": "#86bafe"
    },
    "enumMember": {
      "foreground": "#b6aaff"
    },
    "macro": {
      "foreground": "#58c4fd"
    },
    "comment": {
      "foreground": "#7c869c",
      "italic": true
    },
    "operator": {
      "foreground": "#a0abc2"
    },
    "namespace": {
      "foreground": "#f4a16d",
      "bold": true
    }
  }
