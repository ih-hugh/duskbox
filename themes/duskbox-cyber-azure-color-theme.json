    },
    "property": {
      "foreground": "#3ae5ff"
    },
    "string": {
      "foreground": "#76e87d"
    },
    "number": {
      "foreground": "#82c5fe"
    },
    "enumMember": {
      "foreground": "#b1b7fd"
    },
    "macro": {
      "foreground": "#6bcafe"
    },
    "comment": {
      "foreground": "#b2b8c1",
      "italic": true
    },
    "operator": {
      "foreground": "#cbd1da"
    },
    "namespace": {
      "foreground": "#feb16f",
      "bold": true
    }
  }
