{
  "name": "Duskbox Night HC",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#191a20",
    "editor.foreground": "#fafcff",
    "editorLineNumber.foreground": "#c8cad0",
    "editorLineNumber.activeForeground": "#f7c243",
    "editorCursor.foreground": "#fafcff",
    "editor.selectionBackground": "#282e37",
    "editor.lineHighlightBackground": "#22242a",
    "editorWhitespace.foreground": "#282e37",
    "editorIndentGuide.background1": "#22242a",
    "editorIndentGuide.activeBackground1": "#a9cefd",
    "editor.findMatchBackground": "#282e37",
    "editor.findMatchHighlightBackground": "#22242a",
    "sideBar.background": "#13151a",
    "sideBar.foreground": "#e2e5ea",
    "sideBarTitle.foreground": "#fafcff",
    "activityBar.background": "#13151a",
    "activityBar.foreground": "#fafcff",
    "activityBarBadge.background": "#a9cefd",
    "activityBarBadge.foreground": "#191a20",
    "statusBar.background": "#13151a",
    "statusBar.foreground": "#e2e5ea",
    "statusBar.noFolderBackground": "#13151a",
    "statusBar.debuggingBackground": "#feb98f",
    "titleBar.activeBackground": "#13151a",
    "titleBar.activeForeground": "#fafcff",
    "tab.activeBackground": "#191a20",
    "tab.inactiveBackground": "#13151a",
    "tab.activeForeground": "#fafcff",
    "tab.inactiveForeground": "#c8cad0",
    "tab.activeBorderTop": "#a9cefd",
    "editorGroupHeader.tabsBackground": "#13151a",
    "panel.background": "#13151a",
    "panel.border": "#282e37",
    "terminal.background": "#191a20",
    "terminal.foreground": "#fafcff",
    "list.activeSelectionBackground": "#282e37",
    "list.activeSelectionForeground": "#fafcff",
    "list.inactiveSelectionBackground": "#22242a",
    "list.hoverBackground": "#22242a",
    "list.highlightForeground": "#feb98f",
    "input.background": "#13151a",
    "input.foreground": "#fafcff",
    "input.border": "#282e37",
    "focusBorder": "#a9cefd",
    "foreground": "#e2e5ea",
    "widget.shadow": "#00000066",
    "button.background": "#a9cefd",
    "button.foreground": "#191a20",
    "badge.background": "#a9cefd",
    "badge.foreground": "#191a20",
    "gitDecoration.addedResourceForeground": "#88e48c",
    "gitDecoration.modifiedResourceForeground": "#a9cefd",
    "gitDecoration.deletedResourceForeground": "#feb5b1",
    "editorError.foreground": "#feb5b1",
    "editorWarning.foreground": "#f7c243",
    "editorInfo.foreground": "#a9cefd",
    "terminal.ansiBlack": "#22242a",
    "terminal.ansiRed": "#feb5b1",
    "terminal.ansiGreen": "#88e48c",
    "terminal.ansiYellow": "#f7c243",
    "terminal.ansiBlue": "#a9cefd",
    "terminal.ansiMagenta": "#fea8f6",
    "terminal.ansiCyan": "#69dcfe",
    "terminal.ansiWhite": "#e2e5ea",
    "terminal.ansiBrightBlack": "#282e37",
    "terminal.ansiBrightRed": "#feb5b1",
    "terminal.ansiBrightGreen": "#88e48c",
    "terminal.ansiBrightYellow": "#f7c243",
    "terminal.ansiBrightBlue": "#a9cefd",
    "terminal.ansiBrightMagenta": "#fea8f6",
    "terminal.ansiBrightCyan": "#69dcfe",
    "terminal.ansiBrightWhite": "#fafcff"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#feb5b1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a9cefd"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#f7c243"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "entity.name.type.constructor"
      ],
      "settings": {
        "foreground": "#feb98f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#feb98f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.type.builtin",
        "constant.language"
      ],
      "settings": {
        "foreground": "#feb98f"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f7c243"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#69dcfe"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#15e9d7"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#a9cefd"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#feb98f"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#a9cefd"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#a9cefd"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#fafcff"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#feb98f"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c8cad0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#e2e5ea"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#feb5b1",
      "bold": true
    },
    "function": {
      "foreground": "#f7c243"
    },
    "method": {
      "foreground": "#f7c243"
    },
    "type": {
      "foreground": "#feb98f",
      "bold": true
    },
    "class": {
      "foreground": "#feb98f",
      "bold": true
    },
    "struct": {
      "foreground": "#feb98f",
      "bold": true
    },
    "interface": {
      "foreground": "#feb98f",
      "bold": true
    },
    "enum": {
      "foreground": "#feb98f",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#feb98f",
      "bold": true
    },
    "parameter": {
      "foreground": "#f7c243"
    },
    "variable": {
      "foreground": "#fafcff"
    },
    "property": {
      "foreground": "#a9cefd"
    },
    "string": {
      "foreground": "#69dcfe"
    },
    "number": {
      "foreground": "#a9cefd"
    },
    "enumMember": {
      "foreground": "#a9cefd"
    },
    "macro": {
      "foreground": "#feb98f"
    },
    "comment": {
      "foreground": "#c8cad0",
      "italic": true
    },
    "operator": {
      "foreground": "#a9cefd"
    },
    "namespace": {
      "foreground": "#feb98f",
      "bold": true
    }
  }
}
