{
  "name": "Duskbox Day HC",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#0b0d12",
    "editorLineNumber.foreground": "#2e3036",
    "editorLineNumber.activeForeground": "#694e05",
    "editorCursor.foreground": "#0b0d12",
    "editor.selectionBackground": "#e4e4e4",
    "editor.lineHighlightBackground": "#f2f2f2",
    "editorWhitespace.foreground": "#e4e4e4",
    "editorIndentGuide.background1": "#f2f2f2",
    "editorIndentGuide.activeBackground1": "#01519f",
    "editor.findMatchBackground": "#e4e4e4",
    "editor.findMatchHighlightBackground": "#f2f2f2",
    "sideBar.background": "#f7f7f7",
    "sideBar.foreground": "#1b1d22",
    "sideBarTitle.foreground": "#0b0d12",
    "activityBar.background": "#f7f7f7",
    "activityBar.foreground": "#0b0d12",
    "activityBarBadge.background": "#01519f",
    "activityBarBadge.foreground": "#ffffff",
    "statusBar.background": "#f7f7f7",
    "statusBar.foreground": "#1b1d22",
    "statusBar.noFolderBackground": "#f7f7f7",
    "statusBar.debuggingBackground": "#813d02",
    "titleBar.activeBackground": "#f7f7f7",
    "titleBar.activeForeground": "#0b0d12",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f7f7f7",
    "tab.activeForeground": "#0b0d12",
    "tab.inactiveForeground": "#2e3036",
    "tab.activeBorderTop": "#01519f",
    "editorGroupHeader.tabsBackground": "#f7f7f7",
    "panel.background": "#f7f7f7",
    "panel.border": "#e4e4e4",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#0b0d12",
    "list.activeSelectionBackground": "#e4e4e4",
    "list.activeSelectionForeground": "#0b0d12",
    "list.inactiveSelectionBackground": "#f2f2f2",
    "list.hoverBackground": "#f2f2f2",
    "list.highlightForeground": "#813d02",
    "input.background": "#f7f7f7",
    "input.foreground": "#0b0d12",
    "input.border": "#e4e4e4",
    "focusBorder": "#01519f",
    "foreground": "#1b1d22",
    "widget.shadow": "#00000066",
    "button.background": "#01519f",
    "button.foreground": "#ffffff",
    "badge.background": "#01519f",
    "badge.foreground": "#ffffff",
    "gitDecoration.addedResourceForeground": "#056519",
    "gitDecoration.modifiedResourceForeground": "#01519f",
    "gitDecoration.deletedResourceForeground": "#9d0221",
    "editorError.foreground": "#9d0221",
    "editorWarning.foreground": "#694e05",
    "editorInfo.foreground": "#01519f",
    "terminal.ansiBlack": "#f2f2f2",
    "terminal.ansiRed": "#9d0221",
    "terminal.ansiGreen": "#056519",
    "terminal.ansiYellow": "#694e05",
    "terminal.ansiBlue": "#01519f",
    "terminal.ansiMagenta": "#851980",
    "terminal.ansiCyan": "#005c71",
    "terminal.ansiWhite": "#1b1d22",
    "terminal.ansiBrightBlack": "#e4e4e4",
    "terminal.ansiBrightRed": "#9d0221",
    "terminal.ansiBrightGreen": "#056519",
    "terminal.ansiBrightYellow": "#694e05",
    "terminal.ansiBrightBlue": "#01519f",
    "terminal.ansiBrightMagenta": "#851980",
    "terminal.ansiBrightCyan": "#005c71",
    "terminal.ansiBrightWhite": "#0b0d12"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9d0221",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1b1d22"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#694e05",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "entity.name.type.constructor"
      ],
      "settings": {
        "foreground": "#813d02",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#813d02",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.type.builtin",
        "constant.language"
      ],
      "settings": {
        "foreground": "#5e2f07"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#4d3a09"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#005c71"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#851980"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#01519f"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#5634ac"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#5634ac"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#056058"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#0b0d12"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#5e2f07"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#2e3036",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#1b1d22"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9d0221",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.class.component",
        "entity.name.tag.namespace"
      ],
      "settings": {
        "foreground": "#813d02",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#074743"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#1b1d22"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#9d0221",
      "bold": true
    },
    "function": {
      "foreground": "#694e05",
      "bold": true
    },
    "method": {
      "foreground": "#694e05",
      "bold": true
    },
    "type": {
      "foreground": "#813d02",
      "bold": true
    },
    "class": {
      "foreground": "#813d02",
      "bold": true
    },
    "struct": {
      "foreground": "#813d02",
      "bold": true
    },
    "interface": {
      "foreground": "#813d02",
      "bold": true
    },
    "enum": {
      "foreground": "#813d02",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#813d02",
      "bold": true
    },
    "parameter": {
      "foreground": "#4d3a09"
    },
    "variable": {
      "foreground": "#0b0d12"
    },
    "property": {
      "foreground": "#056058"
    },
    "string": {
      "foreground": "#005c71"
    },
    "number": {
      "foreground": "#01519f"
    },
    "enumMember": {
      "foreground": "#5634ac"
    },
    "macro": {
      "foreground": "#5e2f07"
    },
    "comment": {
      "foreground": "#2e3036",
      "italic": true
    },
    "operator": {
      "foreground": "#1b1d22"
    },
    "namespace": {
      "foreground": "#813d02",
      "bold": true
    }
  }
}
