{
  "name": "Duskbox Cyber",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#13131c",
    "editor.foreground": "#fafcfe",
    "editorLineNumber.foreground": "#c8cbcd",
    "editorLineNumber.activeForeground": "#f6d653",
    "editorCursor.foreground": "#fafcfe",
    "editor.selectionBackground": "#1f262e",
    "editor.lineHighlightBackground": "#1b1b21",
    "editorWhitespace.foreground": "#1f262e",
    "editorIndentGuide.background1": "#1b1b21",
    "editorIndentGuide.activeBackground1": "#82c5fe",
    "editor.findMatchBackground": "#1f262e",
    "editor.findMatchHighlightBackground": "#1b1b21",
    "sideBar.background": "#0d0d12",
    "sideBar.foreground": "#e3e5e7",
    "sideBarTitle.foreground": "#fafcfe",
    "activityBar.background": "#0d0d12",
    "activityBar.foreground": "#fafcfe",
    "activityBarBadge.background": "#82c5fe",
    "activityBarBadge.foreground": "#13131c",
    "statusBar.background": "#0d0d12",
    "statusBar.foreground": "#e3e5e7",
    "statusBar.noFolderBackground": "#0d0d12",
    "statusBar.debuggingBackground": "#feb16f",
    "titleBar.activeBackground": "#0d0d12",
    "titleBar.activeForeground": "#fafcfe",
    "tab.activeBackground": "#13131c",
    "tab.inactiveBackground": "#0d0d12",
    "tab.activeForeground": "#fafcfe",
    "tab.inactiveForeground": "#c8cbcd",
    "tab.activeBorderTop": "#82c5fe",
    "editorGroupHeader.tabsBackground": "#0d0d12",
    "panel.background": "#0d0d12",
    "panel.border": "#1f262e",
    "terminal.background": "#13131c",
    "terminal.foreground": "#fafcfe",
    "list.activeSelectionBackground": "#1f262e",
    "list.activeSelectionForeground": "#fafcfe",
    "list.inactiveSelectionBackground": "#1b1b21",
    "list.hoverBackground": "#1b1b21",
    "list.highlightForeground": "#feb16f",
    "input.background": "#0d0d12",
    "input.foreground": "#fafcfe",
    "input.border": "#1f262e",
    "focusBorder": "#82c5fe",
    "foreground": "#e3e5e7",
    "widget.shadow": "#00000066",
    "button.background": "#82c5fe",
    "button.foreground": "#13131c",
    "badge.background": "#82c5fe",
    "badge.foreground": "#13131c",
    "gitDecoration.addedResourceForeground": "#76e87d",
    "gitDecoration.modifiedResourceForeground": "#82c5fe",
    "gitDecoration.deletedResourceForeground": "#fe7f78",
    "editorError.foreground": "#fe7f78",
    "editorWarning.foreground": "#f6d653",
    "editorInfo.foreground": "#82c5fe",
    "terminal.ansiBlack": "#1b1b21",
    "terminal.ansiRed": "#fe7f78",
    "terminal.ansiGreen": "#76e87d",
    "terminal.ansiYellow": "#f6d653",
    "terminal.ansiBlue": "#82c5fe",
    "terminal.ansiMagenta": "#fe8ef5",
    "terminal.ansiCyan": "#18f5f6",
    "terminal.ansiWhite": "#e3e5e7",
    "terminal.ansiBrightBlack": "#1f262e",
    "terminal.ansiBrightRed": "#fe7f78",
    "terminal.ansiBrightGreen": "#76e87d",
    "terminal.ansiBrightYellow": "#f6d653",
    "terminal.ansiBrightBlue": "#82c5fe",
    "terminal.ansiBrightMagenta": "#fe8ef5",
    "terminal.ansiBrightCyan": "#18f5f6",
    "terminal.ansiBrightWhite": "#fafcfe"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#fe7f78",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#82c5fe"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#f6d653"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "entity.name.type.constructor"
      ],
      "settings": {
        "foreground": "#feb16f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#feb16f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.type.builtin",
        "constant.language"
      ],
      "settings": {
        "foreground": "#feb16f"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f6d653"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#18f5f6"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3ae5ff"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#82c5fe"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#feb16f"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#82c5fe"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#82c5fe"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#fafcfe"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#feb16f"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c8cbcd",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#e3e5e7"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#fe7f78",
      "bold": true
    },
    "function": {
      "foreground": "#f6d653"
    },
    "method": {
      "foreground": "#f6d653"
    },
    "type": {
      "foreground": "#feb16f",
      "bold": true
    },
    "class": {
      "foreground": "#feb16f",
      "bold": true
    },
    "struct": {
      "foreground": "#feb16f",
      "bold": true
    },
    "interface": {
      "foreground": "#feb16f",
      "bold": true
    },
    "enum": {
      "foreground": "#feb16f",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#feb16f",
      "bold": true
    },
    "parameter": {
      "foreground": "#f6d653"
    },
    "variable": {
      "foreground": "#fafcfe"
    },
    "property": {
      "foreground": "#82c5fe"
    },
    "string": {
      "foreground": "#18f5f6"
    },
    "number": {
      "foreground": "#82c5fe"
    },
    "enumMember": {
      "foreground": "#82c5fe"
    },
    "macro": {
      "foreground": "#feb16f"
    },
    "comment": {
      "foreground": "#c8cbcd",
      "italic": true
    },
    "operator": {
      "foreground": "#82c5fe"
    },
    "namespace": {
      "foreground": "#feb16f",
      "bold": true
    }
  }
}
