{
  "name": "Duskbox Storm",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#2c2d36",
    "editor.foreground": "#bec8dc",
    "editorLineNumber.foreground": "#757d90",
    "editorLineNumber.activeForeground": "#d7ba7d",
    "editorCursor.foreground": "#bec8dc",
    "editor.selectionBackground": "#3a434f",
    "editor.lineHighlightBackground": "#363740",
    "editorWhitespace.foreground": "#3a434f",
    "editorIndentGuide.background1": "#363740",
    "editorIndentGuide.activeBackground1": "#99c1f4",
    "editor.findMatchBackground": "#3a434f",
    "editor.findMatchHighlightBackground": "#363740",
    "sideBar.background": "#262730",
    "sideBar.foreground": "#98a2b5",
    "sideBarTitle.foreground": "#bec8dc",
    "activityBar.background": "#262730",
    "activityBar.foreground": "#bec8dc",
    "activityBarBadge.background": "#99c1f4",
    "activityBarBadge.foreground": "#2c2d36",
    "statusBar.background": "#262730",
    "statusBar.foreground": "#98a2b5",
    "statusBar.noFolderBackground": "#262730",
    "statusBar.debuggingBackground": "#eaaf8b",
    "titleBar.activeBackground": "#262730",
    "titleBar.activeForeground": "#bec8dc",
    "tab.activeBackground": "#2c2d36",
    "tab.inactiveBackground": "#262730",
    "tab.activeForeground": "#bec8dc",
    "tab.inactiveForeground": "#757d90",
    "tab.activeBorderTop": "#99c1f4",
    "editorGroupHeader.tabsBackground": "#262730",
    "panel.background": "#262730",
    "panel.border": "#3a434f",
    "terminal.background": "#2c2d36",
    "terminal.foreground": "#bec8dc",
    "list.activeSelectionBackground": "#3a434f",
    "list.activeSelectionForeground": "#bec8dc",
    "list.inactiveSelectionBackground": "#363740",
    "list.hoverBackground": "#363740",
    "list.highlightForeground": "#eaaf8b",
    "input.background": "#262730",
    "input.foreground": "#bec8dc",
    "input.border": "#3a434f",
    "focusBorder": "#99c1f4",
    "foreground": "#98a2b5",
    "widget.shadow": "#00000066",
    "button.background": "#99c1f4",
    "button.foreground": "#2c2d36",
    "badge.background": "#99c1f4",
    "badge.foreground": "#2c2d36",
    "gitDecoration.addedResourceForeground": "#9ccd9c",
    "gitDecoration.modifiedResourceForeground": "#99c1f4",
    "gitDecoration.deletedResourceForeground": "#f0a8a5",
    "editorError.foreground": "#f0a8a5",
    "editorWarning.foreground": "#d7ba7d",
    "editorInfo.foreground": "#99c1f4",
    "terminal.ansiBlack": "#363740",
    "terminal.ansiRed": "#f0a8a5",
    "terminal.ansiGreen": "#9ccd9c",
    "terminal.ansiYellow": "#d7ba7d",
    "terminal.ansiBlue": "#99c1f4",
    "terminal.ansiMagenta": "#deaad8",
    "terminal.ansiCyan": "#7ccbe4",
    "terminal.ansiWhite": "#98a2b5",
    "terminal.ansiBrightBlack": "#3a434f",
    "terminal.ansiBrightRed": "#f0a8a5",
    "terminal.ansiBrightGreen": "#9ccd9c",
    "terminal.ansiBrightYellow": "#d7ba7d",
    "terminal.ansiBrightBlue": "#99c1f4",
    "terminal.ansiBrightMagenta": "#deaad8",
    "terminal.ansiBrightCyan": "#7ccbe4",
    "terminal.ansiBrightWhite": "#bec8dc"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f0a8a5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#99c1f4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "entity.name.type.constructor"
      ],
      "settings": {
        "foreground": "#eaaf8b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#eaaf8b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.type.builtin",
        "constant.language"
      ],
      "settings": {
        "foreground": "#eaaf8b"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#7ccbe4"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7ad0c5"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#99c1f4"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#eaaf8b"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#99c1f4"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#99c1f4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#bec8dc"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#eaaf8b"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#757d90",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#98a2b5"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#f0a8a5",
      "bold": true
    },
    "function": {
      "foreground": "#d7ba7d"
    },
    "method": {
      "foreground": "#d7ba7d"
    },
    "type": {
      "foreground": "#eaaf8b",
      "bold": true
    },
    "class": {
      "foreground": "#eaaf8b",
      "bold": true
    },
    "struct": {
      "foreground": "#eaaf8b",
      "bold": true
    },
    "interface": {
      "foreground": "#eaaf8b",
      "bold": true
    },
    "enum": {
      "foreground": "#eaaf8b",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#eaaf8b",
      "bold": true
    },
    "parameter": {
      "foreground": "#d7ba7d"
    },
    "variable": {
      "foreground": "#bec8dc"
    },
    "property": {
      "foreground": "#99c1f4"
    },
    "string": {
      "foreground": "#7ccbe4"
    },
    "number": {
      "foreground": "#99c1f4"
    },
    "enumMember": {
      "foreground": "#99c1f4"
    },
    "macro": {
      "foreground": "#eaaf8b"
    },
    "comment": {
      "foreground": "#757d90",
      "italic": true
    },
    "operator": {
      "foreground": "#99c1f4"
    },
    "namespace": {
      "foreground": "#eaaf8b",
      "bold": true
    }
  }
}
