    },
    "string": {
      "foreground": "#9ccd9c"
    },
    "number": {
      "foreground": "#99c1f4"
    },
    "enumMember": {
      "foreground": "#bcb5f1"
    },
    "macro": {
      "foreground": "#eda0dc"
    },
    "comment": {
      "foreground": "#757d90",
      "italic": true
    },
    "operator": {
      "foreground": "#98a2b5"
    },
    "namespace": {
      "foreground": "#eaaf8b",
      "bold": true
    }
  }
