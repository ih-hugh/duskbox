{
  "name": "duskbox",
  "displayName": "Duskbox",
  "description": "A calm, equiluminant theme family (16 variants incl. high-contrast, neon & signature accents) for Neovim and VS Code.",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#23242e",
    "theme": "dark"
  },
  "version": "1.1.1",
  "publisher": "ihhugh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ih-hugh/duskbox.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "light",
    "high-contrast",
    "oklch"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Duskbox Dawn",
        "uiTheme": "vs",
        "path": "./themes/duskbox-dawn-color-theme.json"
      },
      {
        "label": "Duskbox Day",
        "uiTheme": "vs",
        "path": "./themes/duskbox-day-color-theme.json"
      },
      {
        "label": "Duskbox Day HC",
        "uiTheme": "hc-light",
        "path": "./themes/duskbox-day-hc-color-theme.json"
      },
      {
        "label": "Duskbox Storm",
        "uiTheme": "vs-dark",
        "path": "./themes/duskbox-storm-color-theme.json"
      },
      {
        "label": "Duskbox Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/duskbox-dusk-color-theme.json"
      },
      {
        "label": "Duskbox Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/duskbox-midnight-color-theme.json"
      },
      {
        "label": "Duskbox Night HC",
        "uiTheme": "hc-black",
        "path": "./themes/duskbox-night-hc-color-theme.json"
      },
      {
        "label": "Duskbox Cyber",
        "uiTheme": "hc-black",
        "path": "./themes/duskbox-cyber-color-theme.json"
      },
      {
        "label": "Duskbox Dusk Azure",
        "uiTheme": "vs-dark",
        "path": "./themes/duskbox-dusk-azure-color-theme.json"
      },
      {
        "label": "Duskbox Cyber Azure",
        "uiTheme": "hc-black",
        "path": "./themes/duskbox-cyber-azure-color-theme.json"
      },
      {
        "label": "Duskbox Dusk Neon Purple",
        "uiTheme": "vs-dark",
        "path": "./themes/duskbox-dusk-neon-purple-color-theme.json"
      },
      {
        "label": "Duskbox Cyber Neon Purple",
        "uiTheme": "hc-black",
        "path": "./themes/duskbox-cyber-neon-purple-color-theme.json"
      },
      {
        "label": "Duskbox Dusk Magenta",
        "uiTheme": "vs-dark",
        "path": "./themes/duskbox-dusk-magenta-color-theme.json"
      },
      {
        "label": "Duskbox Cyber Magenta",
        "uiTheme": "hc-black",
        "path": "./themes/duskbox-cyber-magenta-color-theme.json"
      },
      {
        "label": "Duskbox Dusk Salmon",
        "uiTheme": "vs-dark",
        "path": "./themes/duskbox-dusk-salmon-color-theme.json"
      },
      {
        "label": "Duskbox Cyber Salmon",
        "uiTheme": "hc-black",
        "path": "./themes/duskbox-cyber-salmon-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "tsx src/build/index.ts",
    "test": "vitest run",
    "validate:vscode": "node scripts/validate-vscode.mjs",
    "package": "vsce package --no-dependencies -o duskbox.vsix --readme-path README.marketplace.md",
    "gallery": "tsx scripts/gallery.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
